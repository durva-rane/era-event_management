# Flask
FLASK_ENV=development
DEBUG=false
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=false
FORCE_HTTPS=false
TRUSTED_PROXY_HOPS=0

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=era_db

# Finance and payment gateway
PAYMENT_GATEWAY=mock
PAYMENT_CURRENCY=INR
INVOICE_TAX_PERCENT=0
ERA_COMMISSION_PERCENT=5
# Razorpay adapter accepts test-mode keys only (rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP - example for Gmail SMTP with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM=your_email@gmail.com
PUBLIC_BASE_URL=http://127.0.0.1:5000
ENABLE_REMINDER_SCHEDULER=true

# Backup settings (scripts/backup_mysql.sh)
BACKUP_DIR=./backups/mysql
BACKUP_RETENTION_DAYS=14
